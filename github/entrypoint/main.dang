        .withFunction(
          function("verifyTagCi", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Assert that the CODE a tag points at has passed CI on the default branch.\n\nPorted from `pacha/app/.github/workflows/pipeline.yml`, job `release`, step\n«verificar que el código del tag pasó CI en main». Without it any commit\ncould be tagged and shipped to the stores; it is a query, never a rebuild.\n\nTHE INVARIANT IS \"THE PUBLISHED CODE PASSED CI\", NOT \"THIS COMMIT HAS A\nRUN\". With `paths-ignore`, a docs-only commit legitimately has no run of its\nown and a literal check would reject it while nothing is wrong. So: if the\ntag's commit is green, done. If not, walk up to `maxCommits` ancestors for\nthe nearest green one and demand that EVERYTHING changed since then matches\n`ignoredRe`. One line of code without CI fails — which is the case the gate\nexists to catch.\n\n⚠️ \"GREEN\" IS THE CONCLUSION OF A CHECK-RUN, NEVER OF THE RUN. The earlier\nversion asked `gh run list --json conclusion`, which is the verdict of the\nWHOLE run and therefore red as soon as ANY job is. On 2026-09-03 the\n`ios-e2e` lane started running on every push, and overnight NO commit in the\nrepo could satisfy this gate — not even through the ancestor path, which\nread the same list. The code was perfectly validated and tags were\nimpossible. Asking for one named check-run also aligns the release gate with\nthe merge gate: `ci` is the single context the `branch-ci-required` ruleset\nrequires, so a new and still unstable lane can go red without blocking\nreleases — which is exactly the property that makes adding lanes possible.\n\n⚠️ FAILING TO *READ* CHECK-RUNS IS NOT \"NOT GREEN\". The ported bash ended\nits query with `|| echo 0`, so a 404 from a missing `checks: read`\npermission counted as zero green runs and rejected the tag for the wrong\nreason — worse than having no gate, because it looks like a verdict. Here\nevery non-200 throws and names the permission. See the note on the first\n`checkGreen` call below for why that also deletes the bash's preflight\nprobe, and `checkGreen` itself for how far that claim has been proven.")
            .withSourceMap(sourceMap("src/index.ts", 234, 9))
            .withArg("token", typeDef.withObject("Secret"), sourceMap: sourceMap("src/index.ts", 235, 5))
            .withArg("repo", typeDef.withKind(TypeDefKind.STRING_KIND), description: "`owner/name`.", sourceMap: sourceMap("src/index.ts", 236, 5))
            .withArg("sha", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Anything the commits API resolves: a commit sha, a branch,\nor a TAG NAME. Pass `github.ref_name`, not `github.sha`:\nfor an ANNOTATED tag the ref points at a tag object, and\nthe commits API answers 422 «No commit found for SHA» for\nit (measured 2026-09-05 against `wildbitca/pacha` `v3.8.2`,\nwhose ref object is `8eda9c76`, not the commit `bb08c4af`).\nThis is the same reason the bash ran `git rev-list -n1`.", sourceMap: sourceMap("src/index.ts", 237, 5))
            .withArg("checkName", typeDef.withKind(TypeDefKind.STRING_KIND), description: "The check-run name that must be green, e.g. `ci`.", sourceMap: sourceMap("src/index.ts", 238, 5))
            .withArg("ignoredRe", typeDef.withKind(TypeDefKind.STRING_KIND), description: "POSIX/JS regex of paths allowed to change without CI, e.g.\n`^(specs/|docs/)|\\.md$`. Required, never defaulted: a\ndefault here would be a silent policy for repos that never\nchose it.", sourceMap: sourceMap("src/index.ts", 239, 5))
            .withArg("cacheBust", typeDef.withKind(TypeDefKind.STRING_KIND), description: "MUST vary per run (the run id). See the module header.", sourceMap: sourceMap("src/index.ts", 240, 5))
            .withArg("maxCommits", typeDef.withKind(TypeDefKind.INTEGER_KIND), defaultValue: ("50" :: Dagger.JSON), description: "How far to walk. 50 is generous: above that the tag does\nnot hang off anything this CI has seen and rejecting is the\ncorrect answer.", sourceMap: sourceMap("src/index.ts", 241, 5)),
        )
        .withFunction(
          function("workflowRunDurations", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Durations of recent SUCCESSFUL runs of a workflow, newest first, as JSON\n`[{id, attempt, ms}]` — what a card compares the current wall clock against.\n\n`ms` is `updated_at − run_started_at` of the latest attempt. That is the\nrun's wall clock including queueing, which is what a person waiting for it\nexperiences. A run whose timestamps do not parse is dropped, not zeroed: a\nzero would drag the median down and make every run look slow.")
            .withSourceMap(sourceMap("src/index.ts", 869, 9))
            .withArg("token", typeDef.withObject("Secret"), sourceMap: sourceMap("src/index.ts", 870, 5))
            .withArg("repo", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("src/index.ts", 870, 20))
            .withArg("workflowFile", typeDef.withKind(TypeDefKind.STRING_KIND), description: "the workflow's file name (`pipeline.yml`) or its numeric id.", sourceMap: sourceMap("src/index.ts", 870, 34))
            .withArg("branch", typeDef.withKind(TypeDefKind.STRING_KIND), description: "only runs on this branch; empty for all branches.", sourceMap: sourceMap("src/index.ts", 870, 56))
            .withArg("n", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "how many runs to read (1..100).", sourceMap: sourceMap("src/index.ts", 870, 72))
            .withArg("cacheBust", typeDef.withKind(TypeDefKind.STRING_KIND), description: "MUST vary per call.", sourceMap: sourceMap("src/index.ts", 870, 83))
            .withCachePolicy(FunctionCachePolicy.Never),
        )
        .withConstructor(
          function("", typeDef.withObject("Github")),
        ),
    ]
  }

  """
  Run one constructor or function and return its JSON result.

  The request goes in on stdin and the reply comes back on stdout as one JSON
  object, a DispatchReply: `result` carries the function's result, `error` what
  it threw. The dispatcher exits 0 either way and the error travels as data,
  because this is the only way its message reaches the caller: raised here it
  becomes the function's own error, as returnError made it under the builtin
  runtime, where a nonzero exit surfaces as the exec's "exit code: 1" with the
  message buried in the exec log. A nonzero exit is therefore the dispatcher
  itself failing, not the function, and stays an exec error.

  There is no session channel and no FunctionCall round-trip, so the
  dispatcher's logs have to go to stderr to keep stdout clean.

  No workspace reaches here: `sources` already put everything this module builds
  from into the module context, which is what the container below mounts and
  what the call's cache key covers. `callDigest` is the engine's identifier for
  this call, passed to the dispatcher so a nested call it makes can be keyed on
  it.
  """
  pub call(
    receiverType: String!,
    receiverValue: JSON,
    fnName: String!,
    fnArgs: JSON!,
    callDigest: String,
  ): JSON! {
    let checked = requireGenerated
    let request = JSON.encode({{
      receiverType: receiverType,
      receiverValue: receiverValue,
      fnName: fnName,
      fnArgs: fnArgs,
    }})
    let reply = JSON.decode(
      runtime
        .withEnvVariable("DAGGER_MODULE_CALL_DIGEST", callDigest ?? "")
        .withExec(["tsx", "--no-deprecation", "--tsconfig", "tsconfig.json", "__dagger.dispatch.ts", "engine-call"], stdin: request)
        .stdout,
    ) :: DispatchReply!
    let failure = reply.error
    if (failure != null) {
      raise failure.message
    }
    let result = reply.result
    if (result == null) {
      raise "the dispatcher replied with neither a result nor an error"
    }
    result
  }

  """
  The container a call runs in, minus the exec that runs it.

  Every value here was decided when this file was generated: the image, the
  loader, the package manager, the mount layout. Nothing is re-derived at call
  time, so changing the runtime or the module's layout means re-running
  `dagger generate`. Keeping the exec out of this helper is what lets the whole
  build be shared across calls, and across modules that share a prefix.
  """
  let runtime: Container! {
    base
      .withExec(["npm", "install", "-g", "tsx@4.22.4"])
      .withMountedDirectory("/workspace", currentModule.contextDirectory.filter(exclude: ["**/node_modules"]))
      .withWorkdir("/workspace/" + currentModule.sourceSubpath)
      .withMountedDirectory("node_modules", dependencies)
  }

  """
  The image every container here starts from, with whatever the JS runtime needs
  before anything module-specific.

  Shared by runtime and dependencies so the pull, the prefix and the package
  cache are one layer for both rather than two chains that happen to agree.
  """
  let base: Container! {
    container
      .from("node:24.13.1-alpine@sha256:4f696fbf39f383c1e486030ba6b289a5d9af541642fc78ab197e584a113b9c03")
      .withExec(["apk", "add", "--no-cache", "ca-certificates"])
      .withEnvVariable("NODE_OPTIONS", "--use-openssl-ca")
      .withMountedCache("/root/.cache/yarn", cacheVolume("dagger-typescript-yarn"))
  }

  """
  The module's dependencies, installed, as the node_modules a call mounts.

  Built from the module's manifest and lockfile alone — never from its source —
  so editing a function reinstalls nothing. That is also why the install cannot
  live in runtime: every exec after the module is mounted is keyed on
  everything mounted, and anything installed before it under the mount point
  would be hidden by it.
  """
  let dependencies: Directory! {
    base
      .withWorkdir("/deps")
      .withDirectory("/deps", currentModule.source, include: ["package.json", "yarn.lock", ".yarnrc.yml", ".npmrc", "clients/**"])
      .withDirectory("/deps/node_modules", directory)
      .withExec(["yarn", "install", "--prod"])
      .directory("/deps/node_modules")
  }

  """
  Fail with something actionable when a generated file is missing.

  The engine's builtin TypeScript runtime checks this before it builds its
  container, but under an entrypoint nothing runs that runtime — this program
  builds the container itself, so the check has to live here too. Without it a
  gitignored sdk/ surfaces as a module resolution error from inside a container,
  several layers away from the cause.

  Only call() needs it. types() is literals, so a module whose generated tree is
  missing still lists its functions and then fails at the first real call —
  which is the point: the failure names the file and the fix.
  """
  let requireGenerated: Void {
    let dir = currentModule.source
    if (dir.exists("__dagger.dispatch.ts") == false) {
      raise "module \"github\" cannot run: the generated file \"__dagger.dispatch.ts\" is missing. Run `dagger generate` and commit what it writes."
    } else if (dir.exists("clients/loader.gen.ts") == false) {
      raise "module \"github\" cannot run: the generated file \"clients/loader.gen.ts\" is missing. Run `dagger generate` and commit what it writes."
    } else if (dir.exists("clients/dagger/index.ts") == false) {
      raise "module \"github\" cannot run: the generated file \"clients/dagger/index.ts\" is missing. Run `dagger generate` and commit what it writes."
    } else if (dir.exists("clients/dagger/client.gen.ts") == false) {
      raise "module \"github\" cannot run: the generated file \"clients/dagger/client.gen.ts\" is missing. Run `dagger generate` and commit what it writes."
    } else if (dir.exists("clients/dagger/core.js") == false) {
      raise "module \"github\" cannot run: the generated file \"clients/dagger/core.js\" is missing. Run `dagger generate` and commit what it writes."
    } else if (dir.exists("package.json") == false) {
      raise "module \"github\" cannot run: the generated file \"package.json\" is missing. Run `dagger generate` and commit what it writes."
    } else if (dir.exists("tsconfig.json") == false) {
      raise "module \"github\" cannot run: the generated file \"tsconfig.json\" is missing. Run `dagger generate` and commit what it writes."
    } else {
      null
    }
  }
}

"""
What the dispatcher writes to stdout: `result` when the call returned, `error`
when it threw, never both.

`result` is the function's return value as a JSON string — a string rather than
an embedded value for the same reason the request's receiverValue and fnArgs
are: a JSON scalar decodes from a string, and the engine gets the value back
verbatim.
"""
type DispatchReply {
  result: JSON
  error: DispatchError
}

"""
A thrown error as the dispatcher reports it: the message, and nothing else.

The stack is on the dispatcher's stderr, which is the exec log. The values a
typed error carried as extensions through returnError under the builtin runtime
do not cross this boundary: call() can raise nothing richer than a message.
"""
type DispatchError {
  message: String!
}