          "e2e",
          "maestro",
          5,
          0
        ],
        [
          "mutation",
          "stryker",
          0,
          0
        ]
      ]
    }
  },
  {
    "name": "feature-map",
    "why": "decision 1: path segment for unit tests, declared rows for flows, drift reported (chat is undeclared)",
    "fn": "feature-map",
    "args": {
      "report": "=merge-lanes",
      "feature-ids": "[\"adoption\",\"auth\",\"chat\",\"feed\",\"likes\",\"lost-pet\",\"not-found-404\"]",
      "map": "@specs/features/coverage.tsv"
    },
    "expect": {
      ".ok": false,
      ".undeclaredFeatures": [
        "chat"
      ],
      ".unknownFeatures": [],
      ".unmappedScenarios": [],
      ".unassignedTests": [],
      ".report.features | map([.id, .tests, .scenarios, .failed, .covered, .e2e])": [
        [
          "adoption",
          0,
          1,
          0,
          true,
          "flow"
        ],
        [
          "auth",
          0,
          1,
          0,
          true,
          "flow"
        ],
        [
          "chat",
          0,
          0,
          0,
          false,
          "undeclared"
        ],
        [
          "feed",
          0,
          1,
          0,
          true,
          "flow"
        ],
        [
          "likes",
          0,
          1,
          0,
          true,
          "flow"
        ],
        [
          "lost-pet",
          3,
          0,
          1,
          true,
          "uncovered"
        ],
        [
          "not-found-404",
          0,
          0,
          0,
          false,
          "uncovered"
        ]
      ]
    }
  },
  {
    "name": "feature-map-drift",
    "why": "a test directory with no spec, and a scenario with no row, are problems; a fuzzy name never matches",
    "fn": "feature-map",
    "args": {
      "report": "=merge-lanes",
      "feature-ids": "[\"adoption\",\"auth\",\"feed\",\"like\",\"not-found-404\"]",
      "map": "flow\tfeatures\nlogin_otp\tauth\nadopt_button\tadoption\nscroll_feed\tfeed\nrecord_smoke\t-\nUNCOVERED\tnot-found-404\nUNCOVERED\tlike\n"
    },
    "expect": {
      ".ok": false,
      ".unmappedScenarios": [
        "like"
      ],
      ".unknownFeatures": [
        "lost-pet (from test/features/lost_pet/sighting_test.dart)"
      ],
      ".unassignedTests": [
        "test/core/clock_test.dart"
      ],
      ".report.features | map(select(.id == \"like\"))[0].scenarios": 0
    }
  },
  {
    "name": "features-dir",
    "why": "the Directory form reads subdirectories and .md files as features and coverage.tsv as the map",
    "fn": "features",
    "args": {
      "report": "=merge-lanes",
      "specs-dir": "dir:specs/features"
    },
    "expect": {
      ".report.features | map(.id)": [
        "adoption",
        "auth",
        "chat",
        "feed",
        "likes",
        "lost-pet",
        "not-found-404"
      ],
      ".undeclaredFeatures": [
        "chat"
      ]
    }
  },
  {
    "name": "to-metrics",
    "why": "the legacy TestMetrics view keeps total = passed + failed",
    "fn": "to-metrics",
    "args": {
      "report": "=merge-shards"
    },
    "expect": {
      ".": {
        "total": 5,
        "passed": 3,
        "failed": 2,
        "skipped": 1,
        "suites": 2,
        "perFile": [
          {
            "file": "test/core/clock_test.dart",
            "pass": 1,
            "fail": 1
          },
          {
            "file": "test/features/lost_pet/sighting_test.dart",
            "pass": 2,
            "fail": 1
          }
        ],
        "failedNames": [
          "clock throws",
          "compares two strings"
        ]
      }
    }
  },
  {
    "name": "summary",
    "why": "the step summary names lanes, failures, features and report-only numbers",
    "fn": "summary-markdown",
    "args": {
      "reports": [
        "=feature-map.report"
      ]
    },
    "raw": true,
    "contains": [
      "### 🧪 Tests — unit+e2e+mutation",
      "| e2e | maestro | 5 | 0 |",
      "⚠️ undeclared",
      "58.33%",
      "over budget, report-only",
      "`test/core/clock_test.dart:6`"
    ]
  }
